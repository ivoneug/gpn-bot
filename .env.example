# Токен от @BotFather — единственная обязательная переменная
BOT_TOKEN=

# АЗС, за которыми следим (id из API gpnbonus.ru, через запятую).
# 885 = Краснодар, Селезнева, 197/2 (АЗС №1)
# 886 = Краснодар, Уральская, 194/1 (АЗС №2)
# Найти id других АЗС можно командой /find прямо в боте.
TRACKED_STATIONS=885,886

# Виды топлива (id из справочника oilProducts, см. RESEARCH.md).
# 12 = АИ-95, 421 = G-95 (брендированный АИ-95)
# Другие ходовые: 62 = АИ-92, 372 = ДТл, 100032 = G-100
TRACKED_FUELS=12,421

# Интервал опроса API, секунды (минимум 60). 420 = 7 минут.
POLL_INTERVAL_SEC=420
# Разброс интервала в процентах, чтобы не долбить API строго по расписанию
POLL_JITTER_PCT=10

# Писать ли, когда топливо закончилось (true/false)
NOTIFY_ON_GONE=true

# Если API недоступен дольше стольких минут — предупредить, что данные протухли
# (чтобы тишина в боте не читалась как «топлива нет»). 0 = выключить.
STALE_ALERT_MIN=60

# Кому разрешено общаться с ботом (telegram user id через запятую).
# Пусто = разрешено всем, кто найдёт бота.
ALLOWED_USER_IDS=

# Путь к файлу состояния. В docker-compose переопределяется на /app/data/state.json
STATE_FILE=./data/state.json

# debug | info | warn | error
LOG_LEVEL=info
